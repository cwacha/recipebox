{
    "name": "cwacha/recipe-box",
    "description": "Recipe Box \u2013 a small PHP 8 / Bootstrap / jQuery web app to manage cooking recipes.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public"
        ],
        "test": "phpunit",
        "migrate": "@php bin/migrate"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "suggest": {
        "ext-pdo_sqlite": "Required to store recipes in SQLite instead of a JSON file"
    }
}
